{
  "collectionSettings": {
    "intervalSeconds": 10,
    "dataSource": {
      "type": "http",
      "urls": [
        {
          "name": "local-pod-1",
          "url": "http://localhost:3001/metrics"
        }
      ]
    },
    "retentionSettings": {
      "maxDbSizeMB": 200,
      "cleanupIntervalSeconds": 3600
    }
  },
  "charts": [
    {
      "nameChart": "count_response_by_status",
      "chart": {
        "type": "pie",
        "labels": [
          "401",
          "404",
          "500"
        ],
        "datasets": [
          {
            "metric": "proxy_responses_total",
            "label": "Responses by Status",
            "data": [
              {
                "labelFilter": {
                  "status": "401"
                }
              },
              {
                "labelFilter": {
                  "status": "404"
                }
              },
              {
                "labelFilter": {
                  "status": "500"
                }
              }
            ],
            "backgroundColor": [
              "#36A2EB",
              "#FF6384",
              "#FFCE56"
            ]
          }
        ]
      }
    },
    {
      "nameChart": "requests_by_cloud",
      "chart": {
        "type": "bar",
        "labels": [
          "azure-open-ai",
          "azure-ai-foundry"
        ],
        "datasets": [
          {
            "metric": "proxy_requests_cloud_total",
            "label": "content",
            "data": [
              {
                "labelFilter": {
                  "cloud_name": "azure-open-ai"
                }
              },
              {
                "labelFilter": {
                  "cloud_name": "azure-ai-foundry"
                }
              }
            ],
            "backgroundColor": [
              "#36A2EB",
              "#FF6384"
            ]
          }
        ],
        "filters": [
          {
            "type": "selectItem",
            "label": "Method",
            "key": "method",
            "options": [
              "All",
              "POST",
              "GET"
            ],
            "selected": "All"
          }
        ]
      }
    },
    {
      "nameChart": "requests_by_cloud_2",
      "chart": {
        "type": "bar",
        "labels": [
          "azure-open-ai",
          "azure-ai-foundry"
        ],
        "datasets": [
          {
            "metric": "proxy_requests_cloud_total",
            "label": "azure-open-ai",
            "data": [
              {
                "labelFilter": {
                  "cloud_name": "azure-open-ai"
                }
              }
            ],
            "backgroundColor": [
              "#36A2EB"
            ]
          },
          {
            "metric": "proxy_requests_cloud_total",
            "label": "azure-ai-foundry",
            "data": [
              {
                "labelFilter": {
                  "cloud_name": "azure-ai-foundry"
                }
              }
            ],
            "backgroundColor": [
              "#FF6384"
            ]
          }
        ],
        "filters": [
          {
            "type": "selectItem",
            "label": "Method",
            "key": "method",
            "options": [
              "All",
              "POST",
              "GET"
            ],
            "selected": "All"
          }
        ]
      }
    },
    {
      "nameChart": "cpu_load_comparison",
      "chart": {
        "type": "line",
        "labels": [
          "1",
          "2",
          "3",
          "4",
          "5"
        ],
        "datasets": [
          {
            "label": "System CPU Load",
            "metric": "cpu_load_over_time_system",
            "data": [
              {
                "labelFilter": {
                  "time": "1"
                }
              },
              {
                "labelFilter": {
                  "time": "2"
                }
              },
              {
                "labelFilter": {
                  "time": "3"
                }
              },
              {
                "labelFilter": {
                  "time": "4"
                }
              },
              {
                "labelFilter": {
                  "time": "5"
                }
              }
            ],
            "backgroundColor": "rgba(255, 99, 132, 0.5)",
            "borderColor": "rgb(255, 99, 132)"
          },
          {
            "label": "Process CPU Load",
            "metric": "cpu_load_over_time_process",
            "data": [
              {
                "labelFilter": {
                  "time": "1"
                }
              },
              {
                "labelFilter": {
                  "time": "2"
                }
              },
              {
                "labelFilter": {
                  "time": "3"
                }
              },
              {
                "labelFilter": {
                  "time": "4"
                }
              },
              {
                "labelFilter": {
                  "time": "5"
                }
              }
            ],
            "backgroundColor": "rgba(54, 162, 235, 0.5)",
            "borderColor": "rgb(54, 162, 235)"
          }
        ]
      }
    },
    {
      "nameChart": "name",
      "obs": "QUANDO OCORRER O FILTER UMA QUERY PARA CADA DATASET",
      "chart": {
        "type": "bar",
        "labels": [
          "Electronics",
          "Clothing",
          "Books"
        ],
        "datasets": [
          {
            "label": "Overall Sales",
            "data": [
              {
                "labelFilter": {
                  "category": "eletronic"
                }
              },
              {
                "labelFilter": {
                  "category": "clothing"
                }
              },
              {
                "labelFilter": {
                  "category": "books"
                }
              }
            ],
            "backgroundColor": [
              "rgba(255, 99, 132, 0.6)",
              "rgba(54, 162, 235, 0.6)",
              "rgba(255, 206, 86, 0.6)"
            ]
          },
          {
            "label": "Online Sales",
            "data": [
              {
                "labelFilter": {
                  "category": "eletronic"
                }
              },
              {
                "labelFilter": {
                  "category": "clothing"
                }
              },
              {
                "labelFilter": {
                  "category": "books"
                }
              }
            ],
            "backgroundColor": [
              "rgba(75, 192, 192, 0.6)",
              "rgba(153, 102, 255, 0.6)",
              "rgba(255, 159, 64, 0.6)"
            ]
          }
        ],
        "filters": [
          {
            "type": "selectItem",
            "label": "Region",
            "key": "region",
            "options": [
              "All",
              "North",
              "South",
              "East",
              "West"
            ],
            "selected": "All"
          },
          {
            "type": "selectItem",
            "label": "Year",
            "key": "year",
            "options": [
              "All",
              "2023",
              "2024",
              "2025"
            ],
            "selected": "All"
          }
        ]
      }
    }
  ]
}